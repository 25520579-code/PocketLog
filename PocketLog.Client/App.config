<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name="PocketLogDBConn"
             connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=PocketLogDB;Integrated Security=True;Connect Timeout=30;Encrypt=False;TrustServerCertificate=False;"
             providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>