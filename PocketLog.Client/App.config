<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!-- Điền sẵn IP Public tĩnh của Azure Linux VM (eastasia) để mọi máy mở lên tự có sẵn -->
		<add key="DefaultServerHost" value="20.239.65.18" />
		<add key="DefaultServerPort" value="8888" />
	</appSettings>
	<connectionStrings>
		<add name="PocketLogDBConn"
             connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=PocketLogDB;Integrated Security=True;Connect Timeout=30;Encrypt=False;TrustServerCertificate=False;"
             providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>
